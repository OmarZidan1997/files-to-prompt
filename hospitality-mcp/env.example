# Copy this to `.env` (which is gitignored) and fill in the values.
#
#   cp env.example .env

# Hospitable Personal Access Token (pat:read) — used by the custom turnover briefing.
HOSPITABLE_ACCESS_TOKEN=

# Hospitable bearer with scope mcp:use — REQUIRED: lets the chatbot use the full
# Hospitable read-only toolset (reviews, reservations, tasks, calendar, ...).
HOSPITABLE_MCP_TOKEN=

# Anthropic API key (for Claude) — REQUIRED for the chat/analysis to work.
ANTHROPIC_API_KEY=

# Shared staff login password for the web app.
APP_PASSWORD=change-me

# Secret used to sign the session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: port the web app listens on (default 8000). On Render this is set
# automatically — don't override it there.
# PORT=8000

# --- Production only (set automatically by render.yaml; ignore for local dev) ---
# Send the session cookie only over HTTPS. Leave unset/false for local http://.
# COOKIE_SECURE=true
# Where the master conversations JSON is stored. In production point this at a
# persistent disk so chats survive redeploys.
# CONVERSATIONS_FILE=/data/conversations.json
